# ============================================================
# Nutri-RAG — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Virtual environments ---
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/

# --- Environment / secrets (NEVER commit these) ---
.env
.env.local
.env.production
.env.*
!.env.example          # ← .env.example IS safe to commit

# --- Build artifacts ---
dist/
build/
*.egg-info/
.eggs/
*.whl

# --- Test & coverage output ---
.coverage
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Node (if tooling is added) ---
node_modules/
.next/
out/

# --- Logs (runtime — never commit) ---
*.log
npm-debug.log*
yarn-debug.log*
uvicorn.*.log

# --- Vercel ---
.vercel/

# --- Docker ---
*.tar

# --- Recovery / scratch scripts ---
recover_files.py
final_recovery.py

# --- Unrelated projects ---
.HousePriceprediction/